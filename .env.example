# ==============================================================================
# SkillSphere Environment Configuration
# ==============================================================================

# PostgreSQL Configuration
# Update with your PostgreSQL credentials when ready
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD_HERE
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=skillsphere

# Optional: Full Database URL override (e.g. for production or cloud)
# DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/skillsphere

# Security & JWT
SECRET_KEY=skillsphere-production-jwt-secret-key-2026-v1
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# OCR & Tesseract
# Optional: Set full path to tesseract.exe if not in system PATH
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Seed Administrator Credentials
ADMIN_EMAIL=admin@skillsphere.local
ADMIN_PASSWORD=AdminSkillSphere2026!#
ADMIN_NAME=SkillSphere Administrator

# Brevo Transactional Email & Password Reset
# Paste your Brevo API key and sender details below
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=SkillSphere
FRONTEND_BASE_URL=http://localhost:5173
PASSWORD_RESET_EXPIRE_MINUTES=15
