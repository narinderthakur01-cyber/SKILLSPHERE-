# ==============================================================================
# SkillSphere Backend Environment Configuration
# ==============================================================================

POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD_HERE
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=skillsphere

SECRET_KEY=skillsphere-production-jwt-secret-key-2026-v1
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Brevo Transactional Email & Password Reset
# Paste your Brevo API key and sender details below
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=SkillSphere
FRONTEND_BASE_URL=http://localhost:5173
PASSWORD_RESET_EXPIRE_MINUTES=15
EMAIL_VERIFICATION_EXPIRE_MINUTES=30
EMAIL_RESEND_COOLDOWN_SECONDS=60

# Cloudinary Media Storage (Interviews, Videos, Resumes)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_SECURE_DELIVERY=true
CLOUDINARY_UPLOAD_PREFIX=https://api.cloudinary.com/v1_1

# LiveKit Live Video Meeting Infrastructure
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_EGRESS_ENABLED=true
